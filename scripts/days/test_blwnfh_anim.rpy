label blwnfh_test_anim:
    "Допустим ульяна"
    show us sport smile at center with dspr
    "ease 1"
    show us sport grin:
        center
        ease_back 1 xpos -0.2
        #ease 0.25 zoom 1.15
    with dspr
    "Сыбалась в страхе"
    show us sport smile at center with dspr
    "ease 1 субпиксель"
    show us sport grin:
        subpixel True
        center
        ease_back 1 xpos -0.2
        #ease 0.25 zoom 1.15
    with dspr
    "сыбалась в страхе"
    show us sport smile at center with dspr
    "ease 0.5"
    show us sport grin:
        center
        ease_back 0.5 xpos -0.2
        #ease 0.25 zoom 1.15
    with dspr
    "сыбалась в страхе"
    show us sport smile at center with dspr
    "ease 0.1"
    show us sport grin:
        center
        ease_back 0.1 xpos -0.2
        #ease 0.25 zoom 1.15
    with dspr
    "Сыбалась в страхе"
    "Возвращаемся в меню отладки"
    jump blwnfh_test
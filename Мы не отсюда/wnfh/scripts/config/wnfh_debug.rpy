init python:

    config.top_layers.append("wnfh_layer_debugOverlay")

    wnfh_var_defaultDebug = {
        "enabled":      False,
        "perf":         True,
        "channels":     False,
    }
    if persistent.wnfh_var_debug is None or persistent.wnfh_var_debug.keys() != wnfh_var_defaultDebug.keys():
        persistent.wnfh_var_debug = wnfh_var_defaultDebug

    def wnfh_func_toggleDebug():
        if persistent.wnfh_var_debug["enabled"]:
            renpy.play(wnfh_sfx_ui_switchOff)
            persistent.wnfh_var_debug["enabled"] = False
        else:
            renpy.play(wnfh_sfx_ui_switchOn)
            persistent.wnfh_var_debug["enabled"] = True

    class wnfh_class_debugDisplay(renpy.Displayable):
        def __init__(self, type, enabled):
            super(wnfh_class_debugDisplay, self).__init__()
            self.type = type
            self.enabled = enabled

        def render(self, width, height, st, at):
            varList = {
                "perf":         ["performance",             wnfh_func_debug_perf],
                "channels":     ["channels info",           wnfh_func_debug_channelLister],
            }
            renpy.redraw(self, .01)
            if self.enabled:
                returnable = renpy.render(Text("{0}: {1}".format(varList[self.type][0], str(varList[self.type][1]())), style="wnfh_style_debug_text"), width, height, st, at)
            else:
                returnable = renpy.render(Text("{0}: ...".format(varList[self.type][0]), style="wnfh_style_debug_text"), width, height, st, at)
            return returnable

    def wnfh_func_debug_perf():
        frame_times = renpy.display.interface.frame_times
        if len(frame_times) < 11:
            fps = 0.0
            avg_fps = 0.0
            min_fps = 0.0
            cur_time = 0
            max_time = 0
        else:
            ift = [ (j - i) for i, j in zip(frame_times, frame_times[1:]) ]
            fps = 1.0 / (sum(ift[-10:]) / 10.0)
            avg_fps = 1.0 / (sum(ift) / len(ift))
            min_fps = 1.0 / max(ift) if max(ift) != 0 else 0.0
            cur_time = ift[-1] * 1000
            max_time = max(ift) * 1000
        return "\n-   {0:.1f} fps\n-   {1:.1f} fps avg\n-   {2:.1f} fps min\n-   {3:.3f} ms\n-   {4:.3f} ms max".format(fps, avg_fps, min_fps, cur_time, max_time)

    def wnfh_func_debug_channelLister():
        emits = []
        audioEmits = {}
        try:
            for i in sorted(renpy.audio.audio.channels):
                if isinstance(i, str) and renpy.music.get_playing(i):
                    if i.startswith("audio"):
                        if renpy.music.get_playing(i) in audioEmits:
                            audioEmits[renpy.music.get_playing(i)] += 1
                        else:
                            audioEmits[renpy.music.get_playing(i)] = 1
                    else:
                        if renpy.music.get_pause(i):
                            emits.append("{color=#ff3}" + "-   {0}:\n    {1}\n{3}        {2}{4}\n    {5}".format(i, renpy.music.get_playing(i), wnfh_func_debug_channelLen(i), "{size=5}", "{/size}", wnfh_func_debug_channelLen1(i)) + "{/color}")
                        else:
                            emits.append("-   {0}:\n    {1}\n{3}        {2}{4}\n    {5}".format(i, renpy.music.get_playing(i), wnfh_func_debug_channelLen(i), "{size=5}", "{/size}", wnfh_func_debug_channelLen1(i)))
            if len(audioEmits):
                emits.append("-   audio:")
                for i in sorted(audioEmits):
                    emits.append("--  {0}:\n    {1} times".format(i, str(audioEmits[i])))
        except Exception as e:
            return "\nERROR: " + str(e)
        return "\n" + "\n".join(emits)

    def wnfh_func_debug_channelLen(chl):
        if not renpy.music.get_playing(chl):
            return "?"
        if renpy.music.get_playing(chl).endswith(".mp3"):
            return "?"*len(renpy.music.get_playing(chl))
        try:
            return (("■" * int(renpy.music.get_pos(chl) / (renpy.music.get_duration(chl) / (len(renpy.music.get_playing(chl)) * 2)))).ljust(len(renpy.music.get_playing(chl) * 2), "-"))
        except:
            return ("-" * len(renpy.music.get_playing(chl)) * 2)

    def wnfh_func_debug_channelLen1(chl):
        if not renpy.music.get_playing(chl):
            return "?"
        if renpy.music.get_playing(chl).endswith(".mp3"):
            return "?"
        try:
            curr = "{0}:{1}.{2}".format(str(int((renpy.music.get_pos(chl)//60)%60)).zfill(2), str(int(renpy.music.get_pos(chl)%60)).zfill(2), str(int(renpy.music.get_pos(chl)*1000))[-3:])
            leng = "{0}:{1}.{2}".format(str(int((renpy.music.get_duration(chl)//60)%60)).zfill(2), str(int(renpy.music.get_duration(chl)%60)).zfill(2), str(int(renpy.music.get_duration(chl)*1000))[-3:])
            return curr + (" " * (len(renpy.music.get_playing(chl)) - len(curr) - len(leng))) + leng
        except:
            return "00:00.000" + (" " * (len(renpy.music.get_playing(chl)) - 18)) + "00:00.000"

